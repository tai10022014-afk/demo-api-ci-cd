          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Kiểm tra tên khách hàng khớp với dữ liệu bạn vừa nhập trực tiếp",
                  "pm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {",
                  "    pm.response.to.have.jsonBody();",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.booking.firstname).to.eql(\"Nguyen\");",
                  "});",
                  "",
                  "// Lưu lại bookingid để các request sau (Get, Delete) tự động dùng",
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"bookingid\", jsonData.bookingid);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
