    {
      "name": "Negative_Cases",
      "item": [
        {
          "name": "Invalid Authorization",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Hệ thống chặn truy cập hoặc không tìm thấy tài nguyên\", function () {\r",
                  "    // Chấp nhận mã 403 (Forbidden) hoặc 404 (Not Found nếu ID đã bị xóa)\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Nội dung phản hồi hợp lệ khi lỗi\", function () {\r",
                  "    var responseText = pm.response.text();\r",
                  "    // Chấp nhận chữ Forbidden hoặc trang lỗi HTML 404 từ server\r",
                  "    var isValid = responseText.includes(\"Forbidden\") || responseText.includes(\"Not Found\") || responseText.includes(\"no-such-app\");\r",
                  "    pm.expect(isValid).to.be.true;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "token={{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "https://restfulbooker.herokuapp.com/booking/{{bookingid}}",
              "protocol": "https",
              "host": [
