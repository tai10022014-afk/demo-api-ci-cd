              "script": {
                "exec": [
                  "pm.test(\"Đăng nhập thành công (Status 200)\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Lưu token vào biến môi trường\r",
                  "var jsonData = pm.response.json();\r",
                  "pm.environment.set(\"token\", jsonData.token);"
