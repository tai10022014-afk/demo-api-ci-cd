        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {\r",
                  " pm.response.to.have.status(200);\r",
                  "});\r",
                  "// Kiểm tra tên khách hàng khớp với dữ liệu từ file CSV\r",
                  "pm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {\r",
                  " var jsonData = pm.response.json();\r",
                  " var expectedFirstName = pm.iterationData.get(\"firstname\");\r",
                  " pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);\r",
                  "});\r",
                  "// Lưu lại ID\r",
                  "var jsonData = pm.response.json();\r",
                  "pm.environment.set(\"bookingid\", jsonData.bookingid);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"firstname\": \"{{firstname}}\",\r\n  \"lastname\": \"{{lastname}}\",\r\n  \"totalprice\": {{totalprice}},\r\n  \"depositpaid\": {{depositpaid}},\r\n  \"bookingdates\": {\r\n    \"checkin\": \"{{checkin}}\",\r\n    \"checkout\": \"{{checkout}}\"\r\n  },\r\n  \"additionalneeds\": \"{{additionalneeds}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://restful-booker.herokuapp.com/booking",
              "protocol": "https",
              "host": [
                "restful-booker",
                "herokuapp",
                "com"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
