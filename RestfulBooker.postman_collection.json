        {
          "name": "Clean Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Xóa phòng thành công hoặc phòng đã được dọn\", function () {\r",
                  "    // Chấp nhận mã 201 (Xóa thành công) hoặc 404/200 nếu hệ thống đã tự xử lý\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 404]);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "DELETE",
